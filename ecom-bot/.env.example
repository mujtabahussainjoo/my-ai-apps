# ---------------------------------------------------------------------------
# E-commerce AI Support Assistant — environment template
# Copy to `.env` and fill in values. NEVER commit a real `.env` file.
#
# Nested settings use the delimiter `__` (double underscore), e.g. APP__LOG_LEVEL.
# Precedence: environment / .env  >  config/*.yaml defaults.
# Only the values below need changing; everything else has safe YAML defaults.
# ---------------------------------------------------------------------------

# --- Application ---
APP__ENV=development                # development | test | staging | production
APP__DEBUG=false
APP__LOG_LEVEL=info                 # debug | info | warning | error
APP__LOG_FORMAT=structured          # structured (JSON) | plain
APP__SERVICE_HOST=0.0.0.0
APP__SERVICE_PORT=8000

# --- Database (docker-compose service: ecom-bot-pg, host port 5434) ---
DATABASE__URL=postgresql+asyncpg://ecombot:ecombot@localhost:5434/ecombot
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH__JWT_SECRET=change-me-in-production
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_EXPIRES_MINUTES=60

# --- Rate limiting / input limits ---
LIMITS__RATE_LIMIT_PER_MINUTE=60
LIMITS__MAX_MESSAGE_CHARS=4000
LIMITS__MAX_DOCUMENT_BYTES=10485760     # 10 MB

# --- LLM providers (selection via config/llm.yaml defaults; override here) ---
# mock | anthropic | openai | gemini | ollama | openai_compatible
LLM__PROVIDER=mock
LLM__MODEL=claude-sonnet-4-5
LLM__ROUTER_PROVIDER=mock
LLM__ROUTER_MODEL=
LLM__EMBEDDING_PROVIDER=mock         # mock | openai | ollama | huggingface
LLM__EMBEDDING_MODEL=text-embedding-3-small
LLM__EMBEDDING_DIMENSIONS=1536
LLM__TIMEOUT_SECONDS=60
LLM__MAX_RETRIES=3

LLM__ANTHROPIC_API_KEY=
LLM__ANTHROPIC_BASE_URL=
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=
LLM__GOOGLE_API_KEY=
LLM__OLLAMA_BASE_URL=http://localhost:11434
LLM__OLLAMA_EMBED_MODEL=nomic-embed-text
LLM__OPENAI_COMPATIBLE_BASE_URL=
LLM__OPENAI_COMPATIBLE_API_KEY=
LLM__OPENAI_COMPATIBLE_MODEL=

# --- Agent orchestration bounds ---
AGENTS__MAX_GRAPH_ITERATIONS=8
AGENTS__MAX_ROUTING_HOPS=3
AGENTS__MAX_RETRY_ATTEMPTS=2
AGENTS__WORKER_TIMEOUT_SECONDS=30

# --- RAG ---
RAG__TOP_K=5
RAG__DISTANCE_THRESHOLD=0.35
RAG__CHUNK_SIZE=1000
RAG__CHUNK_OVERLAP=150
RAG__RERANK_ENABLED=false

# --- Guardrails ---
GUARDRAILS__ENABLED=true
GUARDRAILS__PROMPT_INJECTION_ACTION=block
GUARDRAILS__REDACT_PII_IN_LOGS=true

# --- Integrations ---
INTEGRATIONS__COMMERCE_PROVIDER=mock          # mock (only option in v1)
INTEGRATIONS__TICKETING_PROVIDER=mock         # mock | jira | servicenow | both | none
INTEGRATIONS__JIRA_BASE_URL=
INTEGRATIONS__JIRA_EMAIL=
INTEGRATIONS__JIRA_API_TOKEN=
INTEGRATIONS__JIRA_PROJECT_KEY=
INTEGRATIONS__JIRA_ISSUE_TYPE=Ticket
INTEGRATIONS__SERVICENOW_INSTANCE=
INTEGRATIONS__SERVICENOW_USERNAME=
INTEGRATIONS__SERVICENOW_PASSWORD=
INTEGRATIONS__SERVICENOW_TABLE=incident

# --- Observability (optional) ---
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__LANGSMITH_TRACING=false
OBSERVABILITY__LANGSMITH_API_KEY=
OBSERVABILITY__LANGSMITH_PROJECT=ecommerce-support

# --- Config directory override (tests/deployments); defaults to ./config ---
# CONFIG_DIR=./config
