# ─────────────────────────────────────────────────────────────────────────────
# my-financ environment template.  Copy to `.env` and fill in.
#   cp .env.example .env
# NEVER commit the real .env.  Exchange secrets must never reach prompts,
# logs, the LLM context, the frontend, or the database in plaintext.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Required for any mutating endpoint. Leave blank and mutations are disabled
# with 503 rather than open; mutating routes also require an X-Operator header
# so the change is attributable to a person.
API_KEY=
API_REQUEST_LOG=true
# Comma-separated list. Requests from other origins are rejected.
CORS_ORIGINS=http://localhost:3000

# ── Database / Redis (docker-compose service names) ─────────────────────────
POSTGRES_USER=financ
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=financ
POSTGRES_HOST=postgres
REDIS_PORT=6379
PROMETHEUS_PORT=9090
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Full override (takes precedence when set):
# DATABASE_URL=postgresql+psycopg://financ:change-me-in-production@postgres:5432/financ

# ── LLM (agent reasoning layer only — never used for math) ──────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# When true the LLM layer is disabled and agents fall back to deterministic
# rule-based reasoning. The risk engine is unaffected — it is always active.
LLM_ENABLED=true

# ── Market data ─────────────────────────────────────────────────────────────
BINANCE_BASE_URL=https://api.binance.com
MARKET_DATA_TIMEOUT_SECONDS=20
# Synthetic data source used only for tests / offline demos.
MARKET_DATA_ALLOW_SYNTHETIC=true

# ── Exchange credentials (testnet only).  Withdrawals MUST stay disabled. ───
EXCHANGE_ID=binance
EXCHANGE_SANDBOX=true               # sandbox/testnet mode via CCXT
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ── TradingView webhook ─────────────────────────────────────────────────────
# TradingView cannot send custom headers, so the shared secret travels in the
# JSON body as "secret" (an X-Webhook-Secret header is also accepted, for
# anything that can set one). Rotate it. See docs/api/tradingview-webhook.md.
TRADINGVIEW_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=8192
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ── Risk engine (hard limits — these are guardrails, not suggestions) ──────
RISK_MAX_POSITION_PCT=5.0          # % of equity per single position
RISK_MAX_TOTAL_EXPOSURE_PCT=40.0   # % of equity in open positions
RISK_MAX_RISK_PER_TRADE_PCT=1.0    # % of equity risked to stop-loss
RISK_DAILY_LOSS_LIMIT_PCT=3.0      # halts trading for the UTC day
RISK_MAX_DRAWDOWN_PCT=15.0         # halts trading until manual reset
RISK_MAX_OPEN_POSITIONS=6
RISK_MAX_STOP_DISTANCE_PCT=5.0     # rejects absurdly wide stops
RISK_MIN_STOP_DISTANCE_PCT=0.25    # rejects stops inside noise
RISK_DEFAULT_LEVERAGE=1.0

# ── Trading mode ────────────────────────────────────────────────────────────
TRADING_MODE=paper                  # backtest | paper | testnet | live
# Live trading requires BOTH of these plus per-order human approval.
# Unset or false means live execution is unreachable at the code level.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_I_UNDERSTAND_THE_RISK=false

# ── Strategy qualification gate (Workflow.md §5) ────────────────────────────
QUALIFY_MIN_WIN_RATE=0.70
QUALIFY_MIN_PROFIT_FACTOR=1.5
QUALIFY_MAX_DRAWDOWN=0.15
QUALIFY_MIN_TRADES=200
QUALIFY_MIN_RISK_REWARD=2.0
QUALIFY_MIN_PAPER_DAYS=30
QUALIFY_MIN_PAPER_TRADES=30

# ── Execution costs (used by backtest + paper fills) ────────────────────────
FEE_BPS=10                          # 0.10% taker fee per side
SLIPPAGE_BPS=5                      # 0.05% slippage per side

# ── MCP ─────────────────────────────────────────────────────────────────────
MCP_ENABLED=true
MCP_ALLOW_ORDER_TOOLS=true          # paper only. Execution tools are unreachable
                                    # from the LLM tool loop in live mode.