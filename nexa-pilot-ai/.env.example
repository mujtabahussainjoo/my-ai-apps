# Copy to backend/.env or export in your shell. Placeholders only — never commit secrets.

# --- runtime ---------------------------------------------------------------
NEXAPILOT_ENVIRONMENT=development
NEXAPILOT_LOG_LEVEL=INFO
NEXAPILOT_LOG_JSON=false
NEXAPILOT_HOST=127.0.0.1
NEXAPILOT_PORT=8765
# Optional bearer token for the local API (also enter it in Settings → API token).
NEXAPILOT_API_TOKEN=
# Keep experiments isolated (defaults to the platform data directory).
NEXAPILOT_DATA_DIR=

# --- storage / secrets -----------------------------------------------------
# keyring (default) | file | memory. keyring degrades to file when no vault exists.
NEXAPILOT_SECRET_BACKEND=keyring
# Leave empty to use the platform data directory database.
NEXAPILOT_DATABASE_URL=

# --- providers (secrets belong in the vault, not here) ---------------------
NEXAPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
NEXAPILOT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NEXAPILOT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NEXAPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXAPILOT_OLLAMA_MODEL=llama3.1
NEXAPILOT_PROVIDER_TIMEOUT_SECONDS=120

# --- research --------------------------------------------------------------
# brave | tavily | searxng | (empty = disabled)
NEXAPILOT_WEB_SEARCH_PROVIDER=
# Only for SearxNG.
NEXAPILOT_WEB_SEARCH_ENDPOINT=

# --- coding ----------------------------------------------------------------
NEXAPILOT_CODING_WORKSPACE_ROOT=
NEXAPILOT_CODING_COMMAND_TIMEOUT_SECONDS=120
NEXAPILOT_CODING_MAX_OUTPUT_BYTES=256000

# --- travel ----------------------------------------------------------------
# amadeus | rail-guidance | (empty = disabled)
NEXAPILOT_TRAVEL_PROVIDER=

# --- finance ---------------------------------------------------------------
# stooq | yahoo | (empty = disabled)
NEXAPILOT_FINANCE_PROVIDER=
NEXAPILOT_FINANCE_BROKER_BASE_URL=
NEXAPILOT_FINANCE_MAX_ORDER_VALUE=10000
NEXAPILOT_FINANCE_MAX_ORDER_QUANTITY=1000

# --- agent bounds ----------------------------------------------------------
NEXAPILOT_MAX_TOOL_ITERATIONS=12
NEXAPILOT_MAX_AGENT_STEPS=24
