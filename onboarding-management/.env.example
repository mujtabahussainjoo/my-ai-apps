# =============================================================================
# BetterUp Onboarding Integration - prototype configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
#   cp .env.example .env
# =============================================================================

# Local mock "demo portal" that simulates the third-party systems
# (Ashby, Workday, Okta, Google Workspace, Slack, Equipment, Tracker).
DEMO_PORTAL_URL=http://127.0.0.1:8088
DEMO_PORTAL_HOST=127.0.0.1
DEMO_PORTAL_PORT=8088

# ---- Dashboard (web UI) -----------------------------------------------------
# WEB_HOST=0.0.0.0 makes the dashboard reachable from other machines;
# use 127.0.0.1 to restrict it to localhost only.
WEB_HOST=0.0.0.0
WEB_PORT=8090
# Set to 1 to use a separately-running demo portal at DEMO_PORTAL_URL
# instead of the in-process one.
WEB_LIVE=0

# ---- OpenAI (exception classification helper) ------------------------------
# If OPENAI_API_KEY is empty the AI helper degrades gracefully and the
# deterministic validation / exception handling still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Runtime knobs ----------------------------------------------------------
# Bounded retries for temporary failures.
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.2

# Durable-ish local stores (JSON files). Production would use a real DB.
LEDGER_PATH=data/idempotency_ledger.json
AUDIT_PATH=data/audit_log.jsonl
EXCEPTIONS_PATH=data/exceptions.json
TRACKER_PATH=data/cohort_tracker.json

# Deadline monitoring: tasks due within this many days are "approaching".
DEADLINE_WARN_DAYS=7
# Reminder cadence (hours) to avoid duplicate reminders every run.
REMINDER_INTERVAL_HOURS=24
